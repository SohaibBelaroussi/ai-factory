# Copy to .env and adjust. Every value has a working local default in
# docker-compose.yml, so .env is optional for local development.

# Postgres password for the factory database (user: factory, db: factory).
PG_PASSWORD=factory-local

# Inngest self-hosted keys. The signing key must be a bare hex string (the
# server rejects the cloud-style "signkey-" prefix). Generate real ones for
# anything beyond local dev:
#   event key:   openssl rand -hex 16
#   signing key: openssl rand -hex 32
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Optional bearer token for the public API. Empty = no auth (local dev only).
# When set, every public endpoint except /health requires
# "Authorization: Bearer <token>".
OPERATOR_TOKEN=

# Only used by the `worker` tools profile for the standalone AUTH_OK test.
# The real factory injects this per-container from the settings table.
CLAUDE_CODE_OAUTH_TOKEN=
